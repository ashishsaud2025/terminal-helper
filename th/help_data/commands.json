      "grep -v '^#' file"
    ]
  },
  {
    "name": "find",
    "summary": "Search for files in a directory hierarchy",
    "description": "Walks a directory tree and filters by name, type, size, and other predicates.",
    "flags": [
      {
        "flag": "-name",
        "meaning": "match basename pattern"
      },
      {
        "flag": "-type f",
        "meaning": "files only"
      },
      {
        "flag": "-mtime",
        "meaning": "modified time"
      },
      {
        "flag": "-exec",
        "meaning": "run command on results"
      },
      {
        "flag": "-print",
        "meaning": "print matches"
      }
    ],
    "examples": [
      "find . -name '*.py'",
      "find /tmp -type f -mtime -1",
      "find . -name '*.log' -delete"
    ]
  },
  {
