[
  {
    "name": "git",
    "summary": "Distributed version control system",
    "description": "Tracks changes in source code and coordinates work between multiple developers. Use subcommands like status, add, commit, push, pull.",
    "flags": [
      {
        "flag": "-C <path>",
        "meaning": "run as if git was started in <path>"
      },
      {
        "flag": "--version",
        "meaning": "show version"
      },
      {
        "flag": "-c <name>=<value>",
        "meaning": "override config"
      }
    ],
    "examples": [
      "git status",
      "git add -A",
      "git commit -m 'msg'",
      "git push origin main"
    ]
  },
  {
